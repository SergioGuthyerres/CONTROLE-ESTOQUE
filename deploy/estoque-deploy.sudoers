# Instalar em /etc/sudoers.d/estoque-deploy com dono root e permissão 440:
#
#   sudo install -m 440 -o root -g root \
#     /opt/estoque/deploy/estoque-deploy.sudoers /etc/sudoers.d/estoque-deploy
#   sudo visudo -c            # confirma que a sintaxe está válida
#
# São dois usuários, de propósito:
#
# "estoque" roda a API. Ele foi criado com --shell /usr/sbin/nologin, e é assim
# que tem de continuar: uma conta de serviço que aceita login é uma conta a
# mais para alguém entrar. Por isso o SSH do deploy NÃO chega nele.
#
# "deploy" existe só para receber a conexão do GitHub Actions. Não roda nada,
# não tem dado nenhum, e a única coisa que consegue fazer é pedir ao sudo para
# executar o script de deploy como "estoque" — que é quem precisa ser o dono
# dos arquivos que o git e o npm escrevem.

# O que a chave do GitHub consegue fazer no servidor, na íntegra.
deploy ALL=(estoque) NOPASSWD: /usr/local/bin/deploy-estoque

# E o que o script consegue fazer de root: reiniciar UM serviço. Escrito por
# extenso, sem curinga — `systemctl restart *` deixaria parar qualquer serviço
# da máquina, o sshd inclusive. Um `NOPASSWD: ALL` resolveria a mesma linha do
# script e transformaria a chave de deploy num acesso root ao servidor.
estoque ALL=(root) NOPASSWD: /usr/bin/systemctl restart estoque-api
