# Modelo do arquivo de produção. No servidor ele vive em /etc/estoque/api.env,
# pertence ao usuário "estoque" e tem permissão 600 — nunca dentro da pasta do
# código, nunca no Git.
#
#   sudo mkdir -p /etc/estoque
#   sudo cp deploy/api.env.example /etc/estoque/api.env
#   sudo nano /etc/estoque/api.env      # preencher os valores
#   sudo chown estoque:estoque /etc/estoque/api.env
#   sudo chmod 600 /etc/estoque/api.env

NODE_ENV=production

# Caminho ABSOLUTO do banco em produção. Com caminho relativo, o arquivo do
# banco muda de lugar conforme o diretório de onde o comando foi executado —
# e um dia a API sobe apontando para um banco vazio.
DATABASE_URL="file:/opt/estoque/backend/prisma/estoque.db"

# GERAR AGORA, no servidor, e não reaproveitar de lugar nenhum:
#   openssl rand -base64 48
# Quem tiver este valor consegue emitir um token de admin válido sem saber
# nenhuma senha. A API recusa subir se ele for curto ou for o texto de exemplo.
JWT_SECRET="COLE_AQUI_O_RESULTADO_DE_openssl_rand_base64_48"

PORT=3000

# Endereço público do PWA (o domínio do Cloudflare Pages). É a única origem
# que o navegador pode usar para chamar esta API. Para mais de um endereço,
# separar por vírgula.
FRONTEND_URL="https://estoque-casa-do-campo.pages.dev"

# A API está atrás do Caddy — sem isto o rate limit vê todos os acessos como
# vindos do mesmo IP (o do proxy) e para de proteger.
TRUST_PROXY=true

# RF07: acima desta quantidade de unidades, a saída exige o aparelho online.
LIMITE_QUANTIDADE_ONLINE=20

# Tentativas de login por IP antes de bloquear temporariamente. Se a loja
# inteira usa o mesmo wi-fi e alguém reclamar de bloqueio, aumentar um pouco —
# login que dá certo não conta para o limite.
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_MINUTOS=15

# Onde os backups são gravados e quantos manter (o script apaga os mais antigos).
BACKUP_DIR=/var/backups/estoque
BACKUP_RETENCAO=30
