# Configuração de DESENVOLVIMENTO. Para produção use deploy/api.env.example,
# que tem valores e cuidados diferentes — ver deploy/README-DEPLOY.md.
#
# Copie para .env (que está no .gitignore e nunca vai para o Git):
#   cp .env.example .env

NODE_ENV=development

# Caminho relativo à pasta prisma/ (onde fica schema.prisma), não à raiz do
# backend — então o arquivo real fica em backend/prisma/dev.db.
# Em produção este caminho precisa ser ABSOLUTO.
DATABASE_URL="file:./dev.db"

# Mínimo de 32 caracteres. Este valor de exemplo só funciona em
# desenvolvimento: a API se recusa a iniciar com ele se NODE_ENV=production.
# Gerar um de verdade com: openssl rand -base64 48
JWT_SECRET="apenas-para-desenvolvimento-local-nao-use-isto-em-producao"

PORT=3000

# Onde a API escuta. Em branco = 0.0.0.0 em dev (permite testar o PWA pelo
# celular na mesma rede) e 127.0.0.1 em produção (só o Caddy fala com ela).
# HOST=0.0.0.0

# Origem liberada no CORS. Aceita vários endereços separados por vírgula.
FRONTEND_URL="http://localhost:5173"

# RF07: acima desse limite de unidades, a saída exige o dispositivo online.
LIMITE_QUANTIDADE_ONLINE=20

# Rate limit do login (por IP). Login que dá certo não conta para o limite.
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_MINUTOS=15

# Atrás de proxy reverso (Caddy/Nginx). Obrigatório true em produção.
TRUST_PROXY=false
