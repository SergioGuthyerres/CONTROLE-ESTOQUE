// Schema do banco — espelha o modelo de dados em docs/especificacao-requisitos.md.
// Qualquer mudança de campo aqui deve ser refletida naquele documento.
//
// SQLite não tem tipo enum nativo, então campos como "tipo"/"motivo"/"perfil"
// são String simples. Os valores válidos são validados na aplicação (ver
// src/lib/enums.ts) — não confie apenas no banco para essa checagem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String @id @default(uuid())
  nome      String @unique
  senhaHash String
  perfil    String // "funcionario" | "admin" — ver src/lib/enums.ts

  // O token JWT dura 30 dias (RNF05: refazer login toda hora é atrito para
  // quem tem baixa maturidade digital). O preço disso é que um celular
  // perdido continua autenticado por 30 dias. Estes três campos são o
  // contrapeso — ver src/middleware/auth.ts:
  //
  // ativo: desliga o acesso de um funcionário que saiu, sem apagar o
  //   usuário (as movimentações dele são registro de auditoria e não podem
  //   perder o autor — ver docs/documento-de-visao.md seção 5.2).
  // tokenVersion: incrementar invalida TODOS os tokens já emitidos para
  //   esse usuário. É o "deslogar de todos os aparelhos".
  // precisaTrocarSenha: senha definida por outra pessoa (admin criou ou
  //   resetou) só serve para uma coisa — trocar a própria senha.
  ativo              Boolean @default(true)
  tokenVersion       Int     @default(0)
  precisaTrocarSenha Boolean @default(false)

  criadoEm        DateTime         @default(now())
  movimentacoes   Movimentacao[]
  pagamentosFiado PagamentoFiado[]
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String    @unique
  produtos Produto[]
}

model Produto {
  id            String         @id @default(uuid())
  nome          String
  categoriaId   String
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  unidade       String // "kg" | "L" | "un" — ver src/lib/enums.ts (fardo/saco vira kg; "un" é o que se conta: balde, vassoura)
  estoqueMinimo Decimal        @default(0)
  criadoEm      DateTime       @default(now())
  movimentacoes Movimentacao[]

  @@index([nome])
  @@index([categoriaId])
}

// Registro append-only: uma movimentação nunca é editada nem apagada.
// O estoque de um produto é sempre a SOMA de todas as suas movimentações
// (entrada/ajuste positivo soma, saida/ajuste negativo subtrai) — nunca um
// campo de saldo que se sobrescreve. Ver docs/documento-de-visao.md, seção 5.2.
model Movimentacao {
  id                String   @id @default(uuid())
  produtoId         String
  produto           Produto  @relation(fields: [produtoId], references: [id])
  usuarioId         String
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  tipo              String // "entrada" | "saida" — ver src/lib/enums.ts (ajuste de inventário é entrada OU saida com motivo "inventario", nunca um 3º tipo)
  motivo            String // "compra" | "devolucao" | "venda" | "perda" | "uso_interno" | "inventario" | "estorno"
  quantidade        Decimal // sempre positiva; "tipo" decide se soma ou subtrai
  valor             Decimal  @default(0)
  origemDispositivo String // id do dispositivo que originou o registro (rastreio de estoque negativo)
  criadoEm          DateTime @default(now())

  // "Desfazer" uma movimentação NÃO a apaga — cria uma movimentação inversa
  // que aponta para ela por aqui (ver src/services/estornoService.ts). É o
  // que mantém o registro append-only: o erro e a correção ficam os dois no
  // histórico, e o estoque se ajusta sozinho porque é soma de movimentações.
  //
  // O @unique é a regra de negócio no banco: uma movimentação só pode ser
  // estornada uma vez. Sem ele, dois cliques no botão criariam dois inversos
  // e o estoque ficaria errado no sentido oposto.
  estornoDeId String?       @unique
  estornoDe   Movimentacao? @relation("Estorno", fields: [estornoDeId], references: [id])
  estorno     Movimentacao? @relation("Estorno")

  // Só fazem sentido numa venda (tipo "saida", motivo "venda"); em qualquer
  // outra movimentação ficam nulos, e a rota recusa se vierem preenchidos.
  //
  // formaPagamento: "a_vista" | "fiado" — ver src/lib/enums.ts. Nulo só nas
  // vendas anteriores a esta funcionalidade; a rota preenche "a_vista" no que
  // entra daqui para frente, porque antes disso não existia outra forma.
  // cliente: nome de quem levou fiado, digitado no balcão. Texto livre de
  //   propósito — obrigar cadastro de cliente antes da venda seria atrito na
  //   hora errada (RNF05), e quem cobra a dívida é gente que conhece o nome.
  formaPagamento String?
  cliente        String?

  // Presente = esta venda fiado já foi paga. Ausente = ainda é dívida.
  pagamentoFiado PagamentoFiado?

  @@index([produtoId])
  @@index([criadoEm])
  @@index([tipo, criadoEm])
  @@index([formaPagamento, criadoEm])
}

// "Dar baixa" num fiado. Tabela separada, e não um campo `pago` na
// Movimentacao, pelo mesmo motivo do estorno: Movimentacao é append-only
// (regra 2 da arquitetura). Marcar pago com UPDATE apagaria a única resposta
// que a loja precisa quando alguém contesta a cobrança — QUEM deu baixa e
// QUANDO. Aqui essa resposta é uma linha nova, que ninguém sobrescreve.
model PagamentoFiado {
  id             String       @id @default(uuid())
  movimentacaoId String       @unique
  movimentacao   Movimentacao @relation(fields: [movimentacaoId], references: [id])

  // Quem deu baixa — não é quem lançou a venda, e é justamente por isso que
  // este campo existe separado do usuarioId da movimentação.
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // Cópia do nome do devedor no momento da baixa. Redundante com
  // Movimentacao.cliente de propósito: é um recibo, e recibo guarda o que
  // estava escrito no dia, não o que o campo diz hoje.
  cliente String

  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@index([cliente])
}
